{
  "name": "vue-golf",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write src/main.js",
    "lint": "eslint --fix src/main.js",
    "fix": "npm run format && npm run lint",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "core-js": "^3.8.3",
    "eslint-plugin-vue": "^9.9.0",
    "firebase": "^8.10.1",
    "vue": "^2.7.16",
    "vue-burger-menu": "^2.0.5",
    "vue-router": "^3.5.1",
    "vuetify": "^2.6.0",
    "vuex": "^3.6.2"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/eslint-parser": "^7.12.16",
    "@babel/preset-env": "^7.28.0",
    "@mdi/font": "^7.0.96",
    "@vitejs/plugin-vue2": "^2.3.3",
    "@vue/babel-preset-app": "^5.0.8",
    "@vue/cli-plugin-babel": "^5.0.8",
    "@vue/compiler-sfc": "^3.5.18",
    "eslint": "^7.26.0",
    "eslint-config-prettier": "^8.3.0",
    "he": "^1.2.0",
    "husky": "^6.0.0",
    "lint-staged": "^11.0.0",
    "prettier": "^2.3.0",
    "sass": "~1.32.0",
    "sass-loader": "^10.0.0",
    "vite": "^4.5.14",
    "vue-template-compiler": "2.7.16",
    "vuetify-loader": "^1.7.0"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "rules": {
      "vue/multi-word-component-names": 0
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
